{
  "id": "ryugi-paseo",
  "name": "Ryugi Monitor",
  "description": "监听 Ryugi 反馈并通知对应 Paseo Agent 继续处理",
  "requirements": {
    "paseo": ">=0.17.3"
  },
  "build": [
    [
      "npm",
      "install",
      "--no-fund",
      "--no-audit"
    ],
    [
      "node",
      "scripts/setup-runtime.mjs"
    ]
  ]
}
